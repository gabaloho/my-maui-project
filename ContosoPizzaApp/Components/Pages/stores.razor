@page "/stores"
@inject HttpClient Http

<h1>Find a Store</h1>
@if (stores == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var store in stores)
        {
            <li>
                <b>@store.Name</b> - @store.Address.Street, @store.Address.City
                <button @onclick="() => SelectStore(store.Id)">Order Here</button>
            </li>
        }
    </ul>
}

@code {
    List<Store>? stores;

    protected override async Task OnInitializedAsync()
    {
        stores = await Http.GetFromJsonAsync<List<Store>>("api/stores");
    }

    void SelectStore(string storeId)
    {
        // Navigate to menu for selected store
        NavigationManager.NavigateTo($"/menu/{storeId}");
    }

    public class Store
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public Address Address { get; set; }
    }
    public class Address
    {
        public string Street { get; set; }
        public string City { get; set; }
    }
}
